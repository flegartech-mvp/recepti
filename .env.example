# Public project settings. The anon key is safe to expose when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required server-only household membership allowlist. Keep this synchronized
# with private.configure_owner_emails(...). All admitted accounts share one
# cookbook, pantry, shopping list, history, settings, and image library.
OWNER_EMAILS=owner@example.com,second-owner@example.com,vukovic.nadia7@gmail.com

# Test-only. Never set these on a production or preview deployment.
E2E_TEST_MODE=0
